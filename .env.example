# ──────────────────────────────────────────────
# Oriana Weddings — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# All variables prefixed with VITE_ are exposed
# to the client-side bundle by Vite.
# ──────────────────────────────────────────────

# ── Web3Forms (FREE email notifications) ─────
# Get your free access key at https://web3forms.com
# Once set, both the Enquiry Form and the Chatbot
# will email lead data directly to your inbox.
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# ── Legacy Enquiry Endpoint (optional) ───────
# If you have a custom backend endpoint for form
# submissions, set it here. Web3Forms takes
# priority if both are set.
# VITE_ENQUIRY_ENDPOINT=https://your-api.example.com/enquiry

# ── Sanity CMS (content editing) ───────────────
# 1. Create a free project at https://www.sanity.io
#    and a dataset called "production".
# 2. Set the dataset visibility to Public (so the
#    site can read published content without a token),
#    and add your site URL under API > CORS origins.
# 3. Fill in the two values below and restart dev.
# 4. Open /studio on the site to edit everything,
#    page by page. Run the seed once to preload it:
#    SANITY_API_TOKEN=<editor-token> node scripts/seed-sanity.mjs
#
# Until these are set, the site runs entirely on its
# built-in content — the CMS can never blank a page.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# ── Sanity write token (seed script ONLY) ──────
# Create at sanity.io/manage > API > Tokens (Editor).
# NEVER prefix with VITE_ — this must stay server-side.
# SANITY_API_TOKEN=
